{
  "manifest_version": 3,
  "name": "Hermes Browser",
  "version": "0.6.1",
  "description": "Lets your Hermes agent control this browser through the Hermes Browser MCP bridge.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["debugger", "tabs", "tabGroups", "scripting", "storage", "alarms", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Hermes Browser", "default_popup": "popup.html" }
}
